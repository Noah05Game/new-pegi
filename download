# Flow (powered by 05 AI) uses Pollinations.
# Paste your key after the = sign, then restart `npm run dev`.
VITE_POLLINATIONS_KEY=sk_PASTE_YOUR_KEY_HERE

# Optional: pick a different text model. Browse them at https://gen.pollinations.ai/v1/models
VITE_POLLINATIONS_MODEL=openai

# Flow looks up each rating on the web first. This model must have web search.
# Fallbacks tried automatically per title: gemini-search, perplexity-fast, perplexity-reasoning.
VITE_POLLINATIONS_SEARCH_MODEL=gemini-search
